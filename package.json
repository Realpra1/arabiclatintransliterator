    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:sensitivity": "node scripts/check-test-sensitivity.mjs",
    "test:stability": "node --test tests/roundtrip-stability.test.mjs",
    "report:stability": "node scripts/report-roundtrip-stability.mjs",
    "baseline:update": "node scripts/capture-baseline.mjs --accept-current-behavior",
    "report:notation": "node scripts/report-notation-stability.mjs",
